# ==============================================================================
# Common Git Ignore for Full-Stack Portfolio (Frontend & Backend)
# ==============================================================================

# ------------------------------------------------------------------------------
# Dependencies & Package Managers (Node.js & Python)
# ------------------------------------------------------------------------------
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# Python Virtual Environments
venv/
*/venv/
.venv/
*/.venv/
env/
*/env/
.env_*/
ENV/
env.bak/
venv.bak/

# ------------------------------------------------------------------------------
# Environment Variables & Secrets (Keep .env.example tracked)
# ------------------------------------------------------------------------------
.env
*/.env
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
!*.env.example
!*/.env.example

# ------------------------------------------------------------------------------
# Python Artifacts, Caches & Bytecode
# ------------------------------------------------------------------------------
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Pytest / Coverage / Linters
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/
.mypy_cache/
.pytype/
.ruff_cache/

# ------------------------------------------------------------------------------
# Frontend Build Outputs & Caches
# ------------------------------------------------------------------------------
frontend/dist/
frontend/dist-ssr/
dist/
dist-ssr/
.next/
out/
.nuxt/
.vuepress/dist
.temp/
.cache/
.parcel-cache/
.turbo/

# ------------------------------------------------------------------------------
# Local Uploads & Static Media Caches
# ------------------------------------------------------------------------------
backend/uploads/*
!backend/uploads/.gitkeep
uploads/*
!uploads/.gitkeep

# ------------------------------------------------------------------------------
# Local Databases
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
backend/*.db
portfolio.db

# ------------------------------------------------------------------------------
# IDE, Editors & Operating System Metadata
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*.swn
*.bak
*.tmp
*~

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp
*.lnk
