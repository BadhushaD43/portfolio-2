# Database Connection
# PostgreSQL (recommended for production):
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/portfolio_db

# MySQL alternative:
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/portfolio_db

# SQLite (zero-config local dev):
# DATABASE_URL=sqlite:///./portfolio.db

# JWT Security - CHANGE THIS in production!
SECRET_KEY=change-this-to-a-long-random-secret-key-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Initial Admin Credentials (auto-seeded on first startup)
ADMIN_EMAIL=badhushad0@gmail.com
ADMIN_PASSWORD=Admin@Badhusha2026

# CORS Allowed Origins (comma-separated list of frontend URLs)
CORS_ORIGINS=https://badhusha-portfolio.vercel.app,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000


